#!/bin/bash
# Doc-family roll-call — enforced by git, not just by the /release ritual.
# Blocks a push when the documentation court isn't whole (orphan routes,
# unpaired digests, missing family headers, dangling links).
#
# This makes "the court audits itself on every push" literally true even if
# a session pushes by hand instead of running /release. Bypass in a genuine
# emergency with `git push --no-verify`.
#
# Wired via core.hooksPath=.githooks (set by `npm install`'s prepare script,
# or manually: git config core.hooksPath .githooks).

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
census="$repo_root/scripts/doc-census.mjs"
[ -f "$census" ] || exit 0                      # no census in this tree → nothing to enforce

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — skipping doc census (install node to enforce it)." >&2
  exit 0                                          # fail open: never block on a missing toolchain
fi

if ! node "$census"; then
  echo "" >&2
  echo "pre-push BLOCKED: the doc family is not whole (see census output above)." >&2
  echo "Fix the family, or bypass for an emergency with: git push --no-verify" >&2
  exit 1
fi

# Icon roll-call — block a push when the shipped Material Symbols subset is out
# of sync with the icon registry (app/lib/icons.ts), i.e. a used icon would
# render as raw ligature text. Pure Node (no font tooling); rebuild with
# `npm run icons`. See docs/performance.md → "Material Symbols icons".
icons_check="$repo_root/scripts/check-icons.mjs"
if [ -f "$icons_check" ] && ! node "$icons_check"; then
  echo "" >&2
  echo "pre-push BLOCKED: the icon subset is stale (see check output above)." >&2
  echo "Run \`npm run icons\` to rebuild it, or bypass with: git push --no-verify" >&2
  exit 1
fi
# Hydration roll-call — block a push that puts the clock back into render.
# `getGreeting()` during SSR bakes the build machine's time into the prerender;
# the resulting hydration mismatch strips the `.fonts-ready` page-gate class
# and takes the section-reveal choreography down with it. Invisible to every
# local check (`next dev` doesn't prerender), so it is enforced here.
# See app/_landing/ANOMALIES.md -> "Clock-in-render wipes the page gate".
hydration_check="$repo_root/scripts/check-hydration-safety.mjs"
if [ -f "$hydration_check" ] && ! node "$hydration_check"; then
  echo "" >&2
  echo "pre-push BLOCKED: the clock is back in render (see check output above)." >&2
  echo "Route it through \`useGreeting()\`, or bypass with: git push --no-verify" >&2
  exit 1
fi

# Production-safety roll-call — two invariants only the deployed site can
# reveal: every page route must prerender static (one `searchParams` read
# flips it dynamic and re-creates the 2–3s dead click), and the security
# headers in next.config.mjs and netlify.toml must stay byte-identical
# (the /resume-blank-for-47-releases layer). See scripts/check-prod-safety.mjs.
prod_check="$repo_root/scripts/check-prod-safety.mjs"
if [ -f "$prod_check" ] && ! node "$prod_check"; then
  echo "" >&2
  echo "pre-push BLOCKED: a production-only invariant broke (see check output above)." >&2
  echo "Fix it, or bypass for an emergency with: git push --no-verify" >&2
  exit 1
fi

exit 0
